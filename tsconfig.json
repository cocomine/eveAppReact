{
    "extends": "@react-native/typescript-config",
    "include": ["**/*.ts", "**/*.tsx"],
    "compilerOptions": {
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "jsx": "react-native",
        "lib": ["es2020"],
        "moduleResolution": "node",
        "noEmit": true,
        "strict": true,
        "target": "esnext"
    },
    "exclude": ["**/node_modules", "**/Pods", "babel.config.js", "metro.config.js", "jest.config.js"]
}
